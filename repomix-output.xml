                        </div>
                    </div>

                    <div className="sticky top-12 md:top-16 z-40 bg-white/80 backdrop-blur-xl border-b border-[#e8e8ed] shadow-sm">
                        <div className="px-3 md:px-6 py-2 md:py-3">
