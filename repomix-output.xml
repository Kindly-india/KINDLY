// Subcomponents

function InputField({ label, value, onChange, icon, type = "text", placeholder }: any) {
  return (
    <div>
      <label className="flex items-center gap-1.5 text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
        {icon} {label}
      </label>
