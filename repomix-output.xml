                  <Input
                    id="name"
                    name="name"
                    type="text"
                    placeholder="John Doe"
                    required
                    className="h-9 md:h-12 bg-gray-100 border-0 rounded-lg md:rounded-xl text-sm md:text-base text-gray-900 placeholder:text-gray-400 focus-visible:ring-2 focus-visible:ring-red-400"
                  />
