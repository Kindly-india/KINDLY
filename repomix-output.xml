        )}

        {/* Mobile View All Link */}
        <div className="md:hidden mt-4 text-center">
          <Link href="/events">
            <Button
              variant="outline"
              className="inline-flex items-center text-purple-600 text-xs hover:underline bg-transparent border-0"
