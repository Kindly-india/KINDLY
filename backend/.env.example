# ── Supabase ───────────────────────────────────────────────────────────────────
# REQUIRED — get from Supabase project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: JWT_SECRET was removed — the backend does not sign its own tokens. Auth
# is validated against Supabase (supabase.auth.getUser). You can delete
# JWT_SECRET from Render too; nothing reads it.

# ── App ────────────────────────────────────────────────────────────────────────
# REQUIRED — set to 'production' on Render
# If missing: localhost:3000 is included in CORS allowlist everywhere
NODE_ENV=production

# REQUIRED in production — public frontend URL, no trailing slash
# Used in email redirect links (auth callbacks, password reset, notifications)
# If missing: falls back to https://www.kindly.co.in — wrong on staging/preview
FRONTEND_URL=https://www.kindly.co.in

PORT=3001

# ── Email ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — Resend API key for transactional email
# If missing: email is silently disabled — no errors thrown, no emails sent
RESEND_API_KEY=

# NOTE: CRON_SECRET has been removed. Event completion now runs via Supabase
# pg_cron (backend/migrations/auto_complete_events_cron.sql) and org approval
# runs through the authenticated admin panel — neither needs a shared secret.

# ── Maps ───────────────────────────────────────────────────────────────────────
# REQUIRED for event location search/reverse-geocode — Ola Maps API key
# Get from: https://cloud.olakrutrim.com (Krutrim Cloud → Maps → Credentials)
# If missing: /events/location-autocomplete and /events/location-reverse-geocode fail
OLA_MAPS_API_KEY=

# ── Error monitoring ───────────────────────────────────────────────────────────
# OPTIONAL — Sentry DSN for error tracking
# If missing: errors logged to console only, Sentry silently disabled
SENTRY_DSN=

# ── Local development only ─────────────────────────────────────────────────────
# OPTIONAL — absolute path to a local Chrome/Chromium binary
# Only needed for local certificate PDF generation
# In production (Render): omit — @sparticuz/chromium provides the binary
# Example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_PATH=
